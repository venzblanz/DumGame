@page "/tapgame"
@rendermode InteractiveServer
@using System.Timers
@implements IDisposable

<PageTitle>Tap Game - DumGame</PageTitle>

<div class="dg-page">
    <a href="/pick" class="dg-back">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        Games
    </a>

    <div class="dg-card relative w-full max-w-[340px] overflow-hidden dg-rise">
        <div class="dg-hud">
            <div><small>Time</small><b>@timeLeft</b></div>
            <div class="text-right"><small>Score</small><b>@score</b></div>
        </div>
        <div class="dg-bar"><i style="width:@(timeLeft * 100 / 20)%"></i></div>

        <div class="grid grid-cols-4 grid-rows-5 aspect-[4/5]">
            @* Render from top to bottom (index 4 down to 0) *@
            @for (int r = 4; r >= 0; r--)
            {
                int currentRow = r;
                for (int c = 0; c < 4; c++)
                {
                    int currentCol = c;
                    <div class="flex justify-center items-center cursor-pointer border border-[var(--line)] overflow-hidden"
                         @onclick="() => TapTile(currentRow, currentCol)">
                        @if (rows.Count > currentRow && rows[currentRow] == currentCol)
                        {
                            <div class="w-[86%] h-[86%] rounded-xl bg-[#c25e53] bg-[url('/images/character.png')] bg-cover bg-center transition-all duration-100 @(currentRow == 0 ? "opacity-100 dg-pop shadow-[0_6px_18px_var(--glow)]" : "opacity-40")"></div>
                        }
                        @if (errorRow == currentRow && errorCol == currentCol)
                        {
                            <div class="w-[86%] h-[86%] rounded-xl bg-[#e5484d] shadow-[0_0_22px_rgba(229,72,77,0.8)] dg-shake"></div>
                        }
                    </div>
                }
            }
        </div>

        @if (!isPlaying)
        {
            <div class="dg-overlay">
                @if (score > 0 || errorRow >= 0)
                {
                    <h2>@(errorRow >= 0 ? "Missed tile" : "Time's up")</h2>
                    <p>Score @score</p>
                }
                else
                {
                    <h2>Tap Game</h2>
                    <p>20 seconds. Hit the lit tile on the bottom row.</p>
                }
                <button class="dg-btn mt-4" @onclick="StartGame">@(score > 0 || errorRow >= 0 ? "Play again" : "Start game")</button>
            </div>
        }
    </div>
</div>

@code {
    private int timeLeft = 20;
    private int score = 0;
    private bool isPlaying = false;
    private List<int> rows = new();
    private Timer? timer;
    private Random rand = new();
    private int errorRow = -1;
    private int errorCol = -1;

    protected override void OnInitialized() => InitializeGrid();

    private void InitializeGrid()
    {
        rows.Clear();
        errorRow = -1;
        errorCol = -1;
        for (int i = 0; i < 5; i++) rows.Add(rand.Next(0, 4));
    }

    private void StartGame()
    {
        InitializeGrid();
        score = 0;
        timeLeft = 20;
        isPlaying = true;

        timer?.Dispose();
        timer = new Timer(1000);
        timer.Elapsed += CountDown;
        timer.Start();
    }

    private void TapTile(int rowIndex, int colIndex)
    {
        if (!isPlaying) return;

        if (rowIndex == 0)
        {
            if (rows[0] == colIndex)
            {
                score++;
                rows.RemoveAt(0);
                rows.Add(rand.Next(0, 4));
            }
            else Fail(rowIndex, colIndex);
        }
        else if (rows[rowIndex] != colIndex) Fail(rowIndex, colIndex);
    }

    private void Fail(int row, int col)
    {
        errorRow = row;
        errorCol = col;
        EndGame();
    }

    private void CountDown(object? sender, ElapsedEventArgs e)
    {
        if (timeLeft > 1) timeLeft--;
        else { timeLeft = 0; EndGame(); }
        InvokeAsync(StateHasChanged);
    }

    private void EndGame()
    {
        isPlaying = false;
        timer?.Stop();
    }

    public void Dispose() => timer?.Dispose();
}