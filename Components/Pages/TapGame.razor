@page "/tapgame"
@rendermode InteractiveServer
@using System.Timers
@implements IDisposable

<PageTitle>Tap Game</PageTitle>

<div class="min-h-screen w-full flex justify-center items-center bg-[url('/images/bg.png')] bg-cover bg-center bg-no-repeat font-sans">
    <div class="w-full max-w-[420px] relative select-none rounded-[20px] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] backdrop-blur-[6px]">
        <div class="flex justify-between items-center px-6 py-[18px] text-[22px] font-bold tracking-wide text-white bg-[linear-gradient(135deg,rgba(255,102,153,0.95),rgba(255,71,133,0.95))] shrink-0">
            <div>
                <span class="opacity-80 font-medium text-[13px] block mb-0.5 uppercase tracking-widest">Time</span>
                @timeLeft
            </div>
            <div>
                <span class="opacity-80 font-medium text-[13px] block mb-0.5 uppercase tracking-widest">Score</span>
                @score
            </div>
        </div>

        <div class="grid grid-cols-4 grid-rows-5 aspect-[4/5] bg-white/[0.08]">
            @* Render from top to bottom (index 4 down to 0) *@
            @for (int r = 4; r >= 0; r--)
            {
                int currentRow = r; // Local copy for the lambda expression
                for (int c = 0; c < 4; c++)
                {
                    int currentCol = c;
                    <div class="flex justify-center items-center cursor-pointer border border-white/[0.08] overflow-hidden" @onclick="() => TapTile(currentRow, currentCol)">
                        @if (rows.Count > currentRow && rows[currentRow] == currentCol)
                        {
                            <div class="w-[92%] h-[92%] rounded-xl bg-pink-500 bg-[url('/images/character.png')] bg-cover bg-center shadow-[0_4px_10px_rgba(0,0,0,0.25)] transition-transform duration-75 ease-out"></div>
                        }
                        @if (errorRow == currentRow && errorCol == currentCol)
                        {
                            <div class="w-[92%] h-[92%] rounded-xl bg-red-500 shadow-[0_0_20px_rgba(255,59,59,0.8)]"></div>
                        }
                    </div>
                }
            }
        </div>

        @if (!isPlaying)
        {
            <div class="absolute inset-0 bg-[rgba(20,20,30,0.75)] backdrop-blur-sm flex flex-col justify-center items-center text-white gap-1.5">
                @if (score > 0)
                {
                    <h2 class="text-[26px] m-0 font-extrabold">Game Over!</h2>
                    <p class="text-base opacity-85 m-0 mb-2.5">Score: @score</p>
                }
                <button class="bg-[linear-gradient(135deg,#ff6699,#ff4785)] text-white border-none px-9 py-3.5 text-base rounded-full cursor-pointer font-bold tracking-wide mt-3.5 shadow-[0_8px_20px_rgba(255,71,133,0.5)] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[0_10px_26px_rgba(255,71,133,0.6)] active:translate-y-0"
                        @onclick="StartGame">
                    @(score > 0 ? "Play Again" : "Start Game")
                </button>
            </div>
        }
    </div>
</div>

@code {
    private int timeLeft = 20;
    private int score = 0;
    private bool isPlaying = false;

    // Each index represents a row (0 is the bottom row).
    // The integer value is the column index (0-3) where the tile is.
    private List<int> rows = new();

    private Timer? timer;
    private Random rand = new Random();

    private int errorRow = -1;
    private int errorCol = -1;

    protected override void OnInitialized()
    {
        InitializeGrid();
    }

    private void InitializeGrid()
    {
        rows.Clear();
        errorRow = -1;
        errorCol = -1;

        // Populate the 5 visible rows
        for (int i = 0; i < 5; i++)
        {
            rows.Add(rand.Next(0, 4));
        }
    }

    private void StartGame()
    {
        InitializeGrid();
        score = 0;
        timeLeft = 20;
        isPlaying = true;

        if (timer != null)
        {
            timer.Dispose();
        }

        timer = new Timer(1000);
        timer.Elapsed += CountDown;
        timer.Start();
    }

    private void TapTile(int rowIndex, int colIndex)
    {
        if (!isPlaying) return;

        // In this game mode, you must always tap the bottom-most active tile (rowIndex 0)
        if (rowIndex == 0)
        {
            if (rows[0] == colIndex)
            {
                // Correct tap! Remove the bottom row and add a new one at the top.
                score++;
                rows.RemoveAt(0);
                rows.Add(rand.Next(0, 4));
            }
            else
            {
                // Wrong tap in the target row
                errorRow = rowIndex;
                errorCol = colIndex;
                EndGame();
            }
        }
        else if (rows[rowIndex] != colIndex)
        {
            // Tapped an empty space somewhere else
            errorRow = rowIndex;
            errorCol = colIndex;
            EndGame();
        }
    }

    private void CountDown(object? sender, ElapsedEventArgs e)
    {
        if (timeLeft > 1)
        {
            timeLeft--;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            timeLeft = 0;
            EndGame();
            InvokeAsync(StateHasChanged);
        }
    }

    private void EndGame()
    {
        isPlaying = false;
        timer?.Stop();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
