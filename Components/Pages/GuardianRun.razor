@page "/guardianrun"
@attribute [StreamRendering]
@rendermode InteractiveServer
@implements IDisposable
@using System.Threading

<PageTitle>Guardian Run - DumGame</PageTitle>

<div class="dg-page">
    <a href="/pick" class="dg-back">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        Games
    </a>

    <div class="flex justify-between w-full max-w-2xl dg-rise">
        <span class="dg-chip">Score <b>@score</b></span>
        <span class="dg-chip">Best <b>@bestScore</b></span>
    </div>

    <div class="dg-card dg-scene relative w-full max-w-2xl h-72 mx-auto overflow-hidden select-none outline-none dg-rise"
         tabindex="0"
         @onkeydown="HandleKeyDown"
         @onclick="Jump">

        <!-- Ground -->
        <div class="absolute left-0 right-0 bottom-0 bg-[rgba(194,94,83,0.12)]" style="height:@(GroundHeight)px;"></div>
        <div class="absolute left-0 right-0 bg-[var(--acc)] shadow-[0_0_12px_var(--glow)]" style="bottom:@(GroundHeight)px; height:3px;"></div>

        <!-- Character -->
        <div class="absolute rounded-full overflow-hidden border-2 border-[var(--acc2)] bg-[var(--card)] shadow-[0_0_22px_var(--glow)]"
             style="left:@(CharLeft)px; bottom:@(GroundHeight + charY)px; width:@(CharSize)px; height:@(CharSize)px;">
            <img src="images/icon_char.png" alt="char" class="w-full h-full object-cover rounded-full" />
        </div>

        <!-- Obstacles -->
        @foreach (var obs in obstacles)
        {
            if (obs.Shape == ObstacleShape.Spike)
            {
                <div @key="obs.Id" class="absolute bg-[var(--acc2)]"
                     style="left:@(obs.X)px; bottom:@(GroundHeight)px; width:@(obs.Width)px; height:@(obs.Height)px; clip-path: polygon(50% 0%, 0% 100%, 100% 100%);"></div>
            }
            else
            {
                <div @key="obs.Id" class="absolute bg-[var(--deep)] border border-[var(--acc)] rounded-sm"
                     style="left:@(obs.X)px; bottom:@(GroundHeight)px; width:@(obs.Width)px; height:@(obs.Height)px;"></div>
            }
        }

        <!-- Overlays -->
        @if (state == GameState.Ready)
        {
            <div class="dg-overlay">
                <h2>Guardian Run</h2>
                <p>Tap, click or press Space to jump</p>
                <button class="dg-btn mt-4" @onclick="StartGame" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M6 3l14 9-14 9z" /></svg>
                    Start game
                </button>
            </div>
        }
        else if (state == GameState.GameOver)
        {
            <div class="dg-overlay">
                <h2>Game over</h2>
                <p>Score @score / Best @bestScore</p>
                <button class="dg-btn mt-4" @onclick="StartGame" @onclick:stopPropagation="true">Play again</button>
            </div>
        }
    </div>
</div>

@code {
    private const double GameWidth = 672;
    private const double GroundHeight = 20;
    private const double CharSize = 56;
    private const double CharLeft = 36;

    private const double Gravity = 2600;
    private const double JumpVelocity = 850;
    private const double TickMs = 20;
    private const double BaseSpeed = 260;
    private double speed = BaseSpeed;

    private enum GameState { Ready, Playing, GameOver }
    private enum ObstacleShape { Spike, Block }

    private class Obstacle
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public double X { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public ObstacleShape Shape { get; set; }
    }

    private GameState state = GameState.Ready;
    private List<Obstacle> obstacles = new();
    private double charY = 0;
    private double charVelocity = 0;
    private int score = 0;
    private int bestScore = 0;
    private double timeSinceSpawn = 0;
    private double nextSpawnGap = 900;
    private Random random = new();
    private Timer? gameTimer;
    private double elapsedSeconds = 0;

    private void StartGame()
    {
        obstacles.Clear();
        charY = 0;
        charVelocity = 0;
        score = 0;
        speed = BaseSpeed;
        timeSinceSpawn = 0;
        elapsedSeconds = 0;
        nextSpawnGap = 900;
        state = GameState.Playing;

        gameTimer?.Dispose();
        gameTimer = new Timer(_ => InvokeAsync(GameTick), null, 0, (int)TickMs);
    }

    private void Jump()
    {
        if (state != GameState.Playing) { StartGame(); return; }
        if (charY <= 0.01) charVelocity = JumpVelocity;
    }

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == " " || e.Key == "ArrowUp" || e.Code == "Space") Jump();
    }

    private void GameTick()
    {
        if (state != GameState.Playing) return;
        double dt = TickMs / 1000.0;
        elapsedSeconds += dt;

        charVelocity -= Gravity * dt;
        charY += charVelocity * dt;
        if (charY <= 0) { charY = 0; charVelocity = 0; }

        speed = BaseSpeed + (elapsedSeconds * 12);

        foreach (var obs in obstacles) obs.X -= speed * dt;
        obstacles.RemoveAll(o => o.X + o.Width < 0);

        timeSinceSpawn += dt * 1000;
        if (timeSinceSpawn >= nextSpawnGap)
        {
            timeSinceSpawn = 0;
            nextSpawnGap = random.Next(700, 1400);
            SpawnObstacle();
        }

        double charLeftEdge = CharLeft;
        double charRightEdge = CharLeft + CharSize;

        foreach (var obs in obstacles)
        {
            bool overlapX = charRightEdge > obs.X && charLeftEdge < obs.X + obs.Width;
            bool overlapY = charY < obs.Height;
            if (overlapX && overlapY) { EndGame(); break; }
        }

        score = (int)(elapsedSeconds * 10);
        InvokeAsync(StateHasChanged);
    }

    private void SpawnObstacle()
    {
        bool isSpike = random.Next(0, 2) == 0;
        obstacles.Add(new Obstacle
        {
            X = GameWidth,
            Width = isSpike ? random.Next(24, 34) : random.Next(20, 30),
            Height = isSpike ? random.Next(35, 55) : random.Next(30, 60),
            Shape = isSpike ? ObstacleShape.Spike : ObstacleShape.Block
        });
    }

    private void EndGame()
    {
        state = GameState.GameOver;
        if (score > bestScore) bestScore = score;
        gameTimer?.Dispose();
        gameTimer = null;
    }

    public void Dispose() => gameTimer?.Dispose();
}