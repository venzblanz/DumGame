@page "/pick"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Pick a game - DumGame</PageTitle>

<!-- Background unchanged - still bg2.png, full screen -->
<div class="min-h-screen w-full bg-[url('/images/bg2.png')] bg-cover bg-center bg-no-repeat font-sans px-6 py-10">

    <div class="max-w-5xl mx-auto bg-gradient-to-r from-indigo-900/40 to-purple-900/40 backdrop-blur-md border border-white/20 rounded-3xl shadow-2xl p-6 select-none mt-30">
        <h1 class="text-white text-xl font-bold uppercase tracking-wide mb-4">Games</h1>

        <div class="flex gap-4 overflow-x-auto pb-2">
            @foreach (var game in _games)
            {
                <!-- Each card: thumbnail image with a "Play" bar overlaid at the bottom -->
                <button @onclick="() => Navigation.NavigateTo(game.Route)"
                        class="group relative flex-shrink-0 w-40 sm:w-44 rounded-3xl overflow-hidden shadow-lg cursor-pointer transition-transform hover:scale-[1.03] active:scale-95">
                    <img src="@game.Image" alt="@game.Title" class="w-full h-full object-cover rounded-4xl border-5" />

                    <!-- Play bar: sits over the bottom of the thumbnail -->
                    <span class="absolute bottom-0 inset-x-10 flex items-center justify-center gap-1.5 bg-black/60 group-hover:bg-black/80 backdrop-blur-sm py-2 text-white text-sm font-semibold rounded-3xl transition-colors">
                        <!-- Simple triangle "play" icon drawn with CSS borders - no extra image asset needed -->
                        <span class="w-0 h-0 border-y-[5px] border-y-transparent border-l-[8px] border-l-white"></span>
                        Play
                    </span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    // Add a new tuple here for each future game - title, thumbnail path,
    // and the route it navigates to. The scrollable row above handles
    // any number of entries without further changes.
    private readonly List<(string Title, string Image, string Route)> _games = new()
    {
        ("Tap Game", "images/game1.png", "/tapgame"),
        ("Tap Tap", "images/game2.png", "/taptap"),
        ("Guardian Run", "images/icon_char.png", "/guardianrun"),
    };
}
