@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="home-container">
    <div class="center-content">
        <button class="start-button" @onclick="NavigateToGame" aria-label="Start Game">
            <img src="images/start.png" alt="Start" class="start-icon" />
        </button>
    </div>
</div>

<style>
    .home-container {
        min-height: 100vh;
        width: 100%;
        margin: -1.5rem; 
        display: flex;
        justify-content: center;
        align-items: center;
        
        background-color: #9283a8; 
        background-image: url('images/bg1.png'); 
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        
        position: relative;
        overflow: hidden;
    }

    .center-content {
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .start-button {
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.2s;
        filter: drop-shadow(0px 10px 15px rgba(0, 0, 0, 0.5));
    }

    .start-button:hover {
        transform: scale(1.08);
        filter: drop-shadow(0px 15px 20px rgba(0, 0, 0, 0.6));
    }

    .start-button:active {
        transform: scale(0.95);
        filter: drop-shadow(0px 5px 8px rgba(0, 0, 0, 0.4));
    }

    .start-icon {
        width: 220px; 
        height: auto;
        border-radius: 24px; 
        object-fit: contain;
    }
</style>

@code {
    private void NavigateToGame()
    {
        // Now redirects to /tapgame
        Navigation.NavigateTo("/pick", forceLoad: true);
    }
}