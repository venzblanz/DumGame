@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="min-h-screen w-full flex justify-center items-center bg-cover bg-center bg-no-repeat bg-[url('/images/bg1.png')] font-sans">
    <div class="z-10 flex flex-col items-center">
        <button class="bg-transparent border-none p-0 cursor-pointer transition-transform duration-200 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] drop-shadow-[0px_10px_15px_rgba(0,0,0,0.5)] hover:scale-108 hover:drop-shadow-[0px_15px_20px_rgba(0,0,0,0.6)] active:scale-95 active:drop-shadow-[0px_5px_8px_rgba(0,0,0,0.4)]"
                @onclick="NavigateToGame"
                aria-label="Start Game">
            <img src="images/start.png" alt="Start" class="w-56 h-auto rounded-3xl object-contain" />
        </button>
    </div>
</div>

@code {
    private void NavigateToGame()
    {
        // Now redirects to /tapgame
        Navigation.NavigateTo("/pick", forceLoad: true);
    }
}