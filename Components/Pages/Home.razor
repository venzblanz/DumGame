@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>DumGame</PageTitle>

<div class="dg-page">
    <div class="text-center dg-rise">
        <p class="dg-eyebrow">Mini game collection</p>
        <h1 class="dg-title dg-grad-text text-6xl sm:text-7xl">DumGame</h1>
        <p class="mt-4 mb-8 mx-auto max-w-sm text-[var(--sub)] leading-relaxed">
            Three quick games built with Blazor and Tailwind. Pick one and beat your best.
        </p>
        <button class="dg-btn" @onclick="NavigateToPick" aria-label="Start">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M6 3l14 9-14 9z" /></svg>
            Start
        </button>
    </div>
</div>

@code {
    private void NavigateToPick() => Navigation.NavigateTo("/pick", forceLoad: true);
}