@page "/pick"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Pick a game - DumGame</PageTitle>

<div class="dg-page">
    <div class="dg-card w-full max-w-5xl p-6 sm:p-8 dg-rise">
        <div class="flex items-end justify-between mb-6">
            <div>
                <p class="dg-eyebrow">DumGame</p>
                <h1 class="dg-title text-3xl">Pick a game</h1>
            </div>
            <span class="dg-chip"><b>@_games.Count</b> games</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-5 overflow-y-auto max-h-[60vh] p-1">
            @foreach (var (game, i) in _games.Select((g, i) => (g, i)))
            {
                <button @onclick="() => Navigation.NavigateTo(game.Route)"
                        class="dg-tile group text-left dg-rise"
                        style="animation-delay:@(i * 90)ms">
                    <div class="relative aspect-square overflow-hidden rounded-xl">
                        <img src="@game.Image" alt="@game.Title"
                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                        <span class="dg-play">
                            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor"><path d="M6 3l14 9-14 9z" /></svg>
                            Play
                        </span>
                    </div>
                    <div class="px-1 pt-3 pb-1 font-semibold">@game.Title</div>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<(string Title, string Image, string Route)> _games = new()
    {
        ("Tap Game", "images/game1.png", "/tapgame"),
        ("Tap Tap", "images/game2.png", "/taptap"),
        ("Guardian Run", "images/icon_char.png", "/guardianrun"),
    };
}