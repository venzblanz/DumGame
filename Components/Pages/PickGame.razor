@page "/pick"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="min-h-screen w-full flex justify-center items-center bg-cover bg-center bg-no-repeat bg-[url('/images/bg2.png')] font-sans">
    <div class="z-10 flex flex-col sm:flex-row items-center gap-8 sm:gap-12">
        <!-- Left Icon: Redirects to /tapgame -->
        <button class="bg-transparent border-none p-0 cursor-pointer transition-transform duration-200 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] drop-shadow-[0px_10px_15px_rgba(0,0,0,0.5)] hover:scale-[1.08] hover:drop-shadow-[0px_15px_20px_rgba(0,0,0,0.6)] active:scale-95 active:drop-shadow-[0px_5px_8px_rgba(0,0,0,0.4)]"
                @onclick='() => NavigateToGame("/tapgame")'
                aria-label="Play Game 1">
            <img src="images/game1.png" alt="Game 1" class="w-56 h-auto rounded-[28px] object-contain" />
        </button>

        <!-- Right Icon: Redirects to /taptap -->
        <button class="bg-transparent border-none p-0 cursor-pointer transition-transform duration-200 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] drop-shadow-[0px_10px_15px_rgba(0,0,0,0.5)] hover:scale-[1.08] hover:drop-shadow-[0px_15px_20px_rgba(0,0,0,0.6)] active:scale-95 active:drop-shadow-[0px_5px_8px_rgba(0,0,0,0.4)]"
                @onclick='() => NavigateToGame("/taptap")'
                aria-label="Play Game 2">
            <img src="images/game2.png" alt="Game 2" class="w-56 h-auto rounded-[28px] object-contain" />
        </button>
    </div>
</div>

@code {
    private void NavigateToGame(string route)
    {
        Navigation.NavigateTo(route);
    }
}