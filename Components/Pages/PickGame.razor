@page "/pick"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="menu-container">
    <div class="button-group">
        <!-- Left Icon: Redirects to /tapgame -->
        <button class="game-button" @onclick='() => NavigateToGame("/tapgame")' aria-label="Play Game 1">
            <img src="images/game1.png" alt="Game 1" class="game-icon" />
        </button>

        <!-- Right Icon: Redirects to /taptap -->
        <button class="game-button" @onclick='() => NavigateToGame("/taptap")' aria-label="Play Game 2">
            <img src="images/game2.png" alt="Game 2" class="game-icon" />
        </button>
    </div>
</div>

<style>
    .menu-container {
        min-height: 100vh;
        width: 100%;
        margin: -1.5rem; 
        display: flex;
        justify-content: center;
        align-items: center;
        
        background-color: #5c85d6; /* Fallback sky blue */
        background-image: url('images/bg2.png'); 
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        
        position: relative;
        overflow: hidden;
    }

    .button-group {
        z-index: 10;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 3rem; /* Spacing between the two icons */
    }

    .game-button {
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.2s;
        filter: drop-shadow(0px 10px 15px rgba(0, 0, 0, 0.5));
    }

    .game-button:hover {
        transform: scale(1.08);
        filter: drop-shadow(0px 15px 20px rgba(0, 0, 0, 0.6));
    }

    .game-button:active {
        transform: scale(0.95);
        filter: drop-shadow(0px 5px 8px rgba(0, 0, 0, 0.4));
    }

    .game-icon {
        width: 220px; 
        height: auto;
        border-radius: 28px; /* Matched to the soft curve in the reference */
        object-fit: contain;
    }
    
    /* Responsive layout: stacks the icons vertically on small screens */
    @@media (max-width: 600px) {
        .button-group {
            flex-direction: column;
            gap: 2rem;
        }
    }
</style>

@code {
    private void NavigateToGame(string route)
    {
        Navigation.NavigateTo(route);
    }
}