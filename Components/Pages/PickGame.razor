@page "/pick"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Pick a game - DumGame</PageTitle>

<div class="min-h-screen w-full flex items-center justify-center bg-[url('/images/bg2.png')] bg-cover bg-center bg-no-repeat font-sans px-6 py-10">

    <div class="w-full max-w-5xl bg-gradient-to-r from-indigo-900/40 to-purple-900/40 backdrop-blur-md border-3 border-white rounded-3xl shadow-2xl p-6 select-none mt-10">
        <h1 class="text-white text-xl font-bold uppercase tracking-wide mb-4">Games</h1>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 overflow-y-auto max-h-[60vh] pr-2">
            @foreach (var game in _games)
            {
                
                <button @onclick="() => Navigation.NavigateTo(game.Route)"
                        class="group relative rounded-2xl overflow-hidden shadow-lg cursor-pointer transition-transform active:scale-95">
                    <img src="@game.Image" alt="@game.Title" class="w-full h-full object-cover border-4 rounded-4xl hover:scale-[1.03]" />

                    <span class="absolute bottom-0 inset-x-4 flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-900/40 to-purple-900/40 group-hover:bg-black/80 backdrop-blur-sm py-2 text-white text-sm font-semibold transition-colors rounded-4xl border-2 border-white">
                        
                        <span class="w-0 h-0 border-y-[5px] border-y-transparent border-l-[8px] border-l-white"></span>
                        Play
                    </span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<(string Title, string Image, string Route)> _games = new()
    {
        ("Tap Game", "images/game1.png", "/tapgame"),
        ("Tap Tap", "images/game2.png", "/taptap"),
        ("Guardian Run", "images/icon_char.png", "/guardianrun"),
    };
}
