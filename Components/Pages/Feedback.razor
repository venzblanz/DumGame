@page "/feedback"
@rendermode InteractiveServer

<PageTitle>Rate & Comment</PageTitle>

<div class="min-h-screen w-full bg-[linear-gradient(rgba(0,0,0,0.45),rgba(0,0,0,0.45)),url('/images/rate-bg.png')] bg-cover bg-center bg-no-repeat bg-fixed bg-black font-sans px-4 pt-20 pb-24 flex flex-col items-center gap-6">

    @* ---------- Rating card (frosted glass over the background) ---------- *@
    <section class="w-full max-w-xl rounded-3xl bg-white/70 backdrop-blur-xl shadow-2xl p-8 sm:p-10">

        @if (_submitted)
        {
            @* Confirmation state: replaces the form after a successful submit *@
            <div class="text-center py-6">
                <h1 class="text-3xl font-semibold text-slate-900">Thanks for the feedback</h1>
                <p class="mt-2 text-slate-600">You rated us @_rating out of 5.</p>
                <button @onclick="Reset"
                        class="mt-6 px-6 py-2.5 rounded-full bg-slate-900 text-white font-medium hover:bg-slate-700 active:scale-95 transition">
                    Leave another review
                </button>
            </div>
        }
        else
        {
            <h1 class="text-3xl font-semibold text-slate-900">How are we doing?</h1>
            <p class="mt-1 text-slate-600">Pick a star rating and tell us what you think.</p>

            @* Star row: hovering previews a rating, clicking locks it in *@
            <div class="mt-6 flex items-center gap-1" @onmouseleave="() => _hover = 0" role="radiogroup" aria-label="Star rating">
                @for (int i = 1; i <= 5; i++)
                {
                    int star = i; @* local copy so each button keeps its own value *@
                    <button type="button"
                            role="radio"
                            aria-checked="@(_rating == star)"
                            aria-label="@star star@(star > 1 ? "s" : "")"
                            @onclick="() => _rating = star"
                            @onmouseover="() => _hover = star"
                            class="p-1 rounded-lg cursor-pointer transition-transform hover:scale-110 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                        <svg viewBox="0 0 24 24" class="w-11 h-11 transition-colors @(star <= Shown ? "fill-amber-400 stroke-amber-500" : "fill-white/60 stroke-slate-400")" stroke-width="1.5" stroke-linejoin="round">
                            <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8L12 2.5z" />
                        </svg>
                    </button>
                }
                <span class="ml-3 text-sm font-medium text-slate-700 min-w-20">@Label</span>
            </div>

            <div class="mt-6 flex flex-col gap-4">
                <input @bind="_name" @bind:event="oninput" maxlength="40" placeholder="Your name (optional)"
                       class="w-full px-4 py-3 rounded-xl bg-white/80 border border-white/60 text-slate-900 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-400" />

                <textarea @bind="_comment" @bind:event="oninput" rows="4" maxlength="500" placeholder="Write a comment..."
                          class="w-full px-4 py-3 rounded-xl bg-white/80 border border-white/60 text-slate-900 placeholder-slate-500 resize-none focus:outline-none focus:ring-2 focus:ring-amber-400"></textarea>

                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500">@_comment.Length / 500</span>
                    <button @onclick="Submit" disabled="@(_rating == 0)"
                            class="px-6 py-2.5 rounded-full bg-slate-900 text-white font-medium hover:bg-slate-700 active:scale-95 transition disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100">
                        Send feedback
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="text-sm text-red-600">@_error</p>
                }
            </div>
        }
    </section>

    @* ---------- Recent reviews ---------- *@
    <section class="w-full max-w-xl">
        @if (_reviews.Count == 0)
        {
            <p class="text-center text-white drop-shadow">No reviews yet. Yours could be the first.</p>
        }
        else
        {
            <div class="flex items-baseline justify-between mb-3 px-1 text-white drop-shadow">
                <h2 class="text-xl font-semibold">What others said</h2>
                <span class="text-sm">@Average.ToString("0.0") average from @_reviews.Count review@(_reviews.Count == 1 ? "" : "s")</span>
            </div>

            <ul class="flex flex-col gap-3">
                @foreach (var r in _reviews.OrderByDescending(x => x.Date))
                {
                    <li class="rounded-2xl bg-white/70 backdrop-blur-xl shadow-lg p-5">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-slate-900">@r.Name</span>
                            <span class="text-amber-500 tracking-widest" aria-label="@r.Stars out of 5">@(new string('★', r.Stars))<span class="text-slate-300">@(new string('★', 5 - r.Stars))</span></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <p class="mt-2 text-slate-700 whitespace-pre-line">@r.Comment</p>
                        }
                        <p class="mt-2 text-xs text-slate-500">@r.Date.ToString("MMM d, yyyy")</p>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    // In-memory store. static so reviews survive navigating away and back,
    // but they are shared by every visitor and reset when the app restarts.
    // Swap this for a database/service when you're ready to persist them.
    private static readonly List<Review> _reviews = new();

    private int _rating;
    private int _hover;
    private string _name = "";
    private string _comment = "";
    private string? _error;
    private bool _submitted;

    // Stars light up to the hovered value while hovering, otherwise to the chosen rating
    private int Shown => _hover > 0 ? _hover : _rating;

    private string Label => Shown switch
    {
        1 => "Poor",
        2 => "Fair",
        3 => "Good",
        4 => "Great",
        5 => "Excellent",
        _ => ""
    };

    private double Average => _reviews.Count == 0 ? 0 : _reviews.Average(r => r.Stars);

    private void Submit()
    {
        if (_rating == 0)
        {
            _error = "Choose a star rating first.";
            return;
        }

        _reviews.Add(new Review
        {
            Name = string.IsNullOrWhiteSpace(_name) ? "Anonymous" : _name.Trim(),
            Stars = _rating,
            Comment = _comment.Trim(),
            Date = DateTime.Now
        });

        _error = null;
        _submitted = true;
    }

    private void Reset()
    {
        _rating = 0;
        _hover = 0;
        _name = "";
        _comment = "";
        _submitted = false;
    }

    private class Review
    {
        public string Name { get; set; } = "";
        public int Stars { get; set; }
        public string Comment { get; set; } = "";
        public DateTime Date { get; set; }
    }
}
