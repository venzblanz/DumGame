@page "/taptap"
@rendermode InteractiveServer
@using System.Threading.Tasks

<PageTitle>Tap Tap - DumGame</PageTitle>

<div class="dg-page">
    <a href="/pick" class="dg-back">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        Games
    </a>

    @foreach (var ball in activeBalls)
    {
        <div @key="ball.Id" class="small-ball" style="--tx: @(ball.TargetX)px; --ty: @(ball.TargetY)px;">
            <img src="images/icon4.png" alt="" class="w-full h-full rounded-full object-cover border-2 border-[var(--acc2)] bg-[var(--card)]" />
        </div>
    }

    <div class="dg-chip">Taps <b>@taps</b></div>

    <div class="relative mt-4">
        <span class="dg-ring"></span>
        <button class="relative block p-0 border-0 bg-transparent cursor-pointer rounded-3xl shadow-[0_20px_50px_var(--glow)] transition-transform duration-100 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] hover:scale-105 active:scale-90"
                @onclick="OnMainIconClicked" aria-label="Tap">
            <img src="images/icon4.png" alt="Main icon" class="w-52 h-52 rounded-3xl object-cover border-2 border-[var(--line)]" />
        </button>
    </div>

    <p class="mt-4 text-sm text-[var(--sub)]">Keep tapping</p>
</div>

@code {
    private List<BallParticle> activeBalls = new();
    private Random random = new();
    private int taps = 0;

    private void OnMainIconClicked()
    {
        taps++;
        int spawnCount = random.Next(3, 6);
        var spawned = new List<BallParticle>();

        for (int i = 0; i < spawnCount; i++)
        {
            var ball = new BallParticle
            {
                Id = Guid.NewGuid(),
                TargetX = random.Next(-300, 301),
                TargetY = random.Next(-300, 301)
            };
            activeBalls.Add(ball);
            spawned.Add(ball);
        }

        _ = CleanupBallsAsync(spawned);
    }

    private async Task CleanupBallsAsync(List<BallParticle> ballsToRemove)
    {
        await Task.Delay(850);
        foreach (var ball in ballsToRemove) activeBalls.Remove(ball);
        await InvokeAsync(StateHasChanged);
    }

    private class BallParticle
    {
        public Guid Id { get; set; }
        public int TargetX { get; set; }
        public int TargetY { get; set; }
    }
}