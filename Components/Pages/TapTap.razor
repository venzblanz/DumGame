@page "/taptap"
@rendermode InteractiveServer
@using System.Threading.Tasks

<div class="min-h-screen w-full flex justify-center items-center bg-cover bg-center bg-no-repeat bg-[url('/images/bg3.png')] font-sans">
    <!-- The flying particles -->
    @foreach (var ball in activeBalls)
    {
        <div @key="ball.Id" class="small-ball" style="--tx: @(ball.TargetX)px; --ty: @(ball.TargetY)px;">
            <img src="images/icon4.png" alt="small icon" class="w-full h-full rounded-full object-cover border-2 border-white bg-white" />
        </div>
    }

    <!-- The main clickable center icon -->
    <div class="z-10 relative">
        <button class="bg-transparent border-none p-0 cursor-pointer transition-transform duration-100 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] drop-shadow-[0px_10px_20px_rgba(0,0,0,0.6)] active:scale-90 active:drop-shadow-[0px_5px_10px_rgba(0,0,0,0.4)]"
                @onclick="OnMainIconClicked">
            <img src="images/icon4.png" alt="Main Icon" class="w-52 h-52 rounded-3xl object-cover" />
        </button>
    </div>
</div>

<style>
    /* Kept as plain CSS: the animation target (--tx, --ty) is set dynamically
       per-particle from C#, which Tailwind's static utility classes can't express. */
    .small-ball {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 70px;
        height: 70px;
        margin-top: -35px;
        margin-left: -35px;
        pointer-events: none;
        z-index: 20;
        animation: burst 0.8s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
    }

    @@keyframes burst {
        0% {
            transform: translate(0, 0) scale(0.5);
            opacity: 1;
        }
        100% {
            transform: translate(var(--tx), var(--ty)) scale(1.2);
            opacity: 0;
        }
    }
</style>

@code {
    private List<BallParticle> activeBalls = new List<BallParticle>();
    private Random random = new Random();

    private void OnMainIconClicked()
    {
        // Spawns 3 to 5 balls per click for a satisfying visual effect
        int spawnCount = random.Next(3, 6);
        var newlySpawnedBalls = new List<BallParticle>();

        for (int i = 0; i < spawnCount; i++)
        {
            var ball = new BallParticle
            {
                Id = Guid.NewGuid(),
                TargetX = random.Next(-300, 301),
                TargetY = random.Next(-300, 301)
            };
            activeBalls.Add(ball);
            newlySpawnedBalls.Add(ball);
        }

        _ = CleanupBallsAsync(newlySpawnedBalls);
    }

    private async Task CleanupBallsAsync(List<BallParticle> ballsToRemove)
    {
        await Task.Delay(850);

        foreach (var ball in ballsToRemove)
        {
            activeBalls.Remove(ball);
        }

        await InvokeAsync(StateHasChanged);
    }

    private class BallParticle
    {
        public Guid Id { get; set; }
        public int TargetX { get; set; }
        public int TargetY { get; set; }
    }
}