@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

@if (!IsOnHome)
{
    <header class="dg-nav">
        <button class="dg-nav-brand" @onclick="GoHome" aria-label="Home" title="Home">
            <img src="images/home_icon.png" alt="Logo" />
            <span>Dum<b>Game</b></span>
        </button>

        <nav class="dg-nav-links">
            <button class="@LinkClass("pick")" @onclick='() => Go("/pick")'>Games</button>
            <button class="@LinkClass("feedback")" @onclick='() => Go("/feedback")'>Feedback</button>
            <button class="dg-nav-icon" @onclick="GoSettings" aria-label="Settings" title="Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </button>
        </nav>
    </header>
}

@code {
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
    private bool IsOnHome => CurrentPath.Length == 0;

    // "Games" also counts as active on the individual game pages
    private static readonly string[] GameRoutes = { "pick", "tapgame", "taptap", "guardianrun" };

    private string LinkClass(string route)
    {
        bool active = route == "pick" ? GameRoutes.Contains(CurrentPath, StringComparer.OrdinalIgnoreCase)
                                      : CurrentPath.Equals(route, StringComparison.OrdinalIgnoreCase);
        return active ? "dg-nav-link active" : "dg-nav-link";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void Go(string route) => Navigation.NavigateTo(route);
    private void GoHome() => Navigation.NavigateTo("/");

    // TODO: your original sent Settings to "/" (which also hides this bar). Point it at a real route.
    private void GoSettings() => Navigation.NavigateTo("/");
}