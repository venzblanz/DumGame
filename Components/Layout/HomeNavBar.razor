@rendermode InteractiveServer
@inject NavigationManager Navigation

@if (!IsOnHome)
{
    <div class="fixed top-4 left-4 right-4 z-100 flex items-center justify-between px-4 py-2 rounded-2xl bg-gradient-to-r from-indigo-900/70 to-purple-900/70 backdrop-blur-md border-2 border-white shadow-lg">

        <div class="flex items-center gap-3">
            <img src="images/home_icon.png" alt="Logo" class="w-9 h-9 rounded-full object-cover ring-2 ring-white/30" />
            <button @onclick="GoHome"
                aria-label="Home"
                title="Home" class="active:scale-95 transition">
                <span class="text-white font-extrabold tracking-wide text-lg uppercase select-none">DumGame</span>
            </button>
            
        </div>

        <button @onclick="GoSettings"
                aria-label="Settings"
                title="Settings"
                class="w-6 h-6 flex items-center justify-center rounded-full active:scale-95 transition">
            <img src="images/settings_white.png" alt="Home" class=" object-contain" />
        </button>
    </div>
}



@code {
    private bool IsOnHome =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Length == 0;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
    private void GoSettings()
    {
        Navigation.NavigateTo("/");
    }
}
